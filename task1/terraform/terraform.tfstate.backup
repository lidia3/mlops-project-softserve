            "root_block_device": [
              {
                "delete_on_termination": true,
                "device_name": "/dev/sda1",
                "encrypted": true,
                "iops": 3000,
                "kms_key_id": "arn:aws:kms:us-east-1:137787521782:key/bb7a4518-9868-4db4-af48-53784e49f3cd",
                "tags": null,
                "tags_all": {},
                "throughput": 125,
                "volume_id": "vol-0381f349527547786",
